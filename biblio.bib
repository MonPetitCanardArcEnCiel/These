@Article{Huang1995,
  author   = {Huang, P. G. and Bradshaw, P.},
  journal  = {AIAAJ},
  title    = {{L}aw of the wall for turbulent flows in pressure gradients},
  year     = {1995},
  number   = {4},
  pages    = {624--632},
  volume   = {33},
  abstract = {Experiments show that pressure gradients have a strong effect on the
	law of the wall for temperature but have comparatively little effect
	on the law of the wall for velocity. This is contrary to the predictions
	of the mixing-length formulas, though these can be derived by apparently
	plausible dimensional analysis. To model this behavior, the choice
	of the transport equation for the turbulence-length scale, or its
	equivalent, becomes crucial; this is true both for two-equation models
	and for full second-moment transport models. This paper is a brief
	review of the experimental evidence, followed by a demonstration
	that the most popular 'length-scale' variable, the dissipation rate
	eps, and its temperature-field equivalent epsT fail to reproduce
	the observed behavior. A more general length-scale variable can be
	defined as k m eps n, where k is the turbulent kinetic energy. It
	is shown that, overall, the omega variable (m = -1, n = 1) seems
	to be the best choice, with its temperature-field equivalent omegaT
	for heat transfer, although there is no obvious physical reason for
	preferring it.},
}

