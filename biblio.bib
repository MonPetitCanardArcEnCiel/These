@article{Tsiakas2024,
  author         = {Tsiakas, Konstantinos and Trompoukis, Xenofon and Asouti, Varvara and Giannakoglou, Kyriakos and Rogé, Gilbert and Julisson, Sarah and Martin, Ludovic and Kleinveld, Steven},
  journal        = {Fluids},
  title          = {Discrete and Continuous Adjoint-Based Aerostructural Wing Shape Optimization of a Business Jet},
  year           = {2024},
  issn           = {2311-5521},
  number         = {4},
  volume         = {9},
  abstract       = {This article presents single- and multi-disciplinary shape optimizations of a generic business jet wing at two transonic cruise flow conditions. The studies performed are based on two high-fidelity gradient-based optimization tools, assisted by the adjoint method (following both discrete and continuous approaches). Single discipline and coupled multi-disciplinary sensitivity derivatives computed from the two tools are compared and verified against finite differences. The importance of not making the frozen turbulence assumption in adjoint-based optimization is demonstrated. Then, a number of optimization runs, ranging from a pure aerodynamic with a rigid structure to an aerostructural one exploring the trade-offs between the involved disciplines, are presented and discussed. The middle-ground scenario of optimizing the wing with aerodynamic criteria and, then, performing an aerostructural trimming is also investigated.},
  article-number = {87},
  doi            = {10.3390/fluids9040087},
  url            = {https://www.mdpi.com/2311-5521/9/4/87}
}

